# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
#   cp .env.example .env          (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
# O arquivo .env NAO e versionado (ver .gitignore), pois contem credenciais.
# ---------------------------------------------------------------------------

# ---------- ORIGEM: SQL Server / AdventureWorks (OLTP) ----------
SRC_SERVER=localhost\SQLEXPRESS
SRC_DATABASE=AdventureWorks2022
SRC_DRIVER=ODBC Driver 18 for SQL Server
# Autenticacao integrada do Windows (yes) ou usuario/senha SQL (no)
SRC_TRUSTED_CONNECTION=yes
SRC_USER=
SRC_PASSWORD=
# Certificado autoassinado do SQL Server local
SRC_TRUST_SERVER_CERTIFICATE=yes

# ---------- DESTINO: PostgreSQL / Data Warehouse (OLAP) ----------
DW_HOST=localhost
DW_PORT=5432
DW_DATABASE=dw_adventureworks
DW_USER=dw_user
DW_PASSWORD=dw_pass

# ---------- Parametros de execucao da ETL ----------
# Tamanho do lote de leitura/gravacao (linhas por bloco)
ETL_BATCH_SIZE=20000
# Margem de seguranca (em segundos) subtraida da marca d'agua a cada carga,
# para tolerar transacoes que confirmaram fora de ordem cronologica.
ETL_LOOKBACK_SECONDS=2
# Intervalo coberto pela dimensao tempo
ETL_DATA_INICIO=2010-01-01
ETL_DATA_FIM=2015-12-31
